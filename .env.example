HV_ILINK_BASE_URL=http://127.0.0.1:8080
HV_ILINK_TOKEN=

# TTS engine: "piper" (local, offline) or "edge" (Microsoft cloud, free).
# Run `hermes-voice-setup` to pick interactively.
HV_TTS_ENGINE=piper

# Piper config (used when HV_TTS_ENGINE=piper)
HV_TTS_MODEL_PATH=

# edge-tts config (used when HV_TTS_ENGINE=edge)
HV_TTS_VOICE=zh-CN-XiaoxiaoNeural
HV_TTS_RATE=+0%
HV_TTS_PITCH=+0Hz

# STT (local faster-whisper, fully offline)
HV_STT_MODEL=base
HV_STT_COMPUTE_TYPE=int8
HV_STT_DEVICE=cpu
